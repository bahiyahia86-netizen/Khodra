{
  "name": "khodra",
  "private": true,
  "version": "1.0.0",
  "description": "برنامج سطح مكتب لإدارة محل خضروات وفواكه",
  "author": "Khodra",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:ui": "vite",
    "dev:app": "vite",
    "dev:server": "KHODRA_DB=sqlite node --import tsx scripts/dev-server.ts",
    "dev:full": "concurrently -k \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:electron": "KHODRA_ELECTRON=1 vite",
    "build": "tsc -b && vite build",
    "build:electron": "KHODRA_ELECTRON=1 vite build && electron-builder",
    "preview": "vite preview",
    "lint": "oxlint",
    "test:logic": "node --import tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.544.0",
    "mysql-memory-server": "^1.16.0",
    "mysql2": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.1",
    "recharts": "^3.2.1",
    "sql.js": "^1.14.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.81.0",
    "tsx": "^4.20.5",
    "typescript": "~5.7.0",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.khodra.app",
    "productName": "خضرة",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "public/icons/**/*",
      "public/brand/**/*",
      "public/favicon.svg",
      "electron/db/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ar"
      ],
      "language": "1025"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
