generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CASHIER
}

enum ProductUnit {
  KG
  PIECE
  BOX
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMethod {
  CASH
  CARD
}

enum WastageReason {
  DAMAGED
  ROTTEN
  TRANSPORT
  OTHER
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(100)
  role         UserRole  @default(CASHIER)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sales          Sale[]
  purchases      Purchase[]
  expenses       Expense[]
  wastages       Wastage[]
  dailyClosings  DailyClosing[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Product {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(120)
  barcode       String?       @unique @db.VarChar(50)
  imagePath     String?       @map("image_path") @db.VarChar(500)
  unit          ProductUnit   @default(KG)
  purchasePrice Decimal       @map("purchase_price") @db.Decimal(12, 2)
  salePrice     Decimal       @map("sale_price") @db.Decimal(12, 2)
  stockQty      Decimal       @default(0) @map("stock_qty") @db.Decimal(12, 3)
  minStock      Decimal       @default(0) @map("min_stock") @db.Decimal(12, 3)
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  wastages      Wastage[]

  @@index([name])
  @@index([status])
  @@map("products")
}

model Sale {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(30)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  paymentMethod PaymentMethod @map("payment_method")
  userId        Int           @map("user_id")
  notes         String?       @db.VarChar(255)
  createdAt     DateTime      @default(now()) @map("created_at")

  user  User       @relation(fields: [userId], references: [id])
  items SaleItem[]

  @@index([createdAt])
  @@index([userId])
  @@index([paymentMethod])
  @@map("sales")
}

model SaleItem {
  id         Int     @id @default(autoincrement())
  saleId     Int     @map("sale_id")
  productId  Int     @map("product_id")
  productName String @map("product_name") @db.VarChar(120)
  unit       ProductUnit
  quantity   Decimal @db.Decimal(12, 3)
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal  Decimal @map("line_total") @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Purchase {
  id            Int      @id @default(autoincrement())
  supplierName  String?  @map("supplier_name") @db.VarChar(120)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  userId        Int      @map("user_id")
  notes         String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")

  user  User           @relation(fields: [userId], references: [id])
  items PurchaseItem[]

  @@index([createdAt])
  @@index([userId])
  @@map("purchases")
}

model PurchaseItem {
  id            Int         @id @default(autoincrement())
  purchaseId    Int         @map("purchase_id")
  productId     Int         @map("product_id")
  productName   String      @map("product_name") @db.VarChar(120)
  unit          ProductUnit
  quantity      Decimal     @db.Decimal(12, 3)
  unitCost      Decimal     @map("unit_cost") @db.Decimal(12, 2)
  lineTotal     Decimal     @map("line_total") @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String   @db.VarChar(200)
  amount      Decimal  @db.Decimal(12, 2)
  category    String   @db.VarChar(80)
  expenseDate DateTime @map("expense_date") @db.Date
  notes       String?  @db.VarChar(255)
  userId      Int      @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([expenseDate])
  @@index([category])
  @@index([userId])
  @@map("expenses")
}

model Wastage {
  id          Int           @id @default(autoincrement())
  productId   Int           @map("product_id")
  productName String        @map("product_name") @db.VarChar(120)
  quantity    Decimal       @db.Decimal(12, 3)
  unit        ProductUnit
  unitCost    Decimal       @map("unit_cost") @db.Decimal(12, 2)
  totalCost   Decimal       @map("total_cost") @db.Decimal(12, 2)
  reason      WastageReason
  notes       String?       @db.VarChar(255)
  userId      Int           @map("user_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([productId])
  @@index([userId])
  @@map("wastage")
}

model DailyClosing {
  id             Int      @id @default(autoincrement())
  closingDate    DateTime @unique @map("closing_date") @db.Date
  totalSales     Decimal  @map("total_sales") @db.Decimal(12, 2)
  cashSales      Decimal  @map("cash_sales") @db.Decimal(12, 2)
  cardSales      Decimal  @map("card_sales") @db.Decimal(12, 2)
  totalPurchases Decimal  @map("total_purchases") @db.Decimal(12, 2)
  totalExpenses  Decimal  @map("total_expenses") @db.Decimal(12, 2)
  totalWastage   Decimal  @map("total_wastage") @db.Decimal(12, 2)
  netAmount      Decimal  @map("net_amount") @db.Decimal(12, 2)
  salesCount     Int      @map("sales_count")
  notes          String?  @db.VarChar(255)
  userId         Int      @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([closingDate])
  @@map("daily_closings")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(80)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  username   String   @db.VarChar(50)
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   Int?     @map("entity_id")
  details    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}
